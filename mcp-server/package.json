{
  "name": "mercury402-mcp",
  "version": "0.1.0",
  "description": "MCP server for Mercury402: discover and call 78 pay-per-call (x402, USDC on Base) financial data endpoints — Treasury, FRED, forex, yield spreads, breakeven inflation, macro composites",
  "license": "MIT",
  "author": "Mercury402",
  "homepage": "https://github.com/dudman1/mercury402/tree/master/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dudman1/mercury402.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/dudman1/mercury402/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "treasury",
    "fred",
    "financial-data",
    "ai-agents"
  ],
  "type": "module",
  "bin": {
    "mercury402-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "generate:catalog": "node scripts/generate-catalog.cjs",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run generate:catalog && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ethers": "^6.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
