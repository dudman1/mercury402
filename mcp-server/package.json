{
  "name": "mercury402-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Mercury402: discover and call pay-per-call (x402) financial data endpoints",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mercury402-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:catalog": "node scripts/generate-catalog.cjs",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ethers": "^6.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
